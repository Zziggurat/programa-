{
  "name": "tablero-studio",
  "version": "1.0.0",
  "description": "Núcleo de TableroStudio: diseño de tableros eléctricos con DRC, numeración IEC, bornes, ruteo de cables y documentación automática",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit -p tsconfig.app.json && tsc && node --test dist/test/*.test.js",
    "ejemplo": "tsc && node dist/ejemplo/generar.js",
    "editor": "vite app",
    "editor:build": "vite build app",
    "empaquetar": "vite build app && node app/empaquetar.mjs",
    "qa": "vite build app --mode qa && node qa/todas.mjs --gate",
    "qa:run": "node qa/todas.mjs --gate",
    "qa:all": "vite build app --mode qa && node qa/todas.mjs --all",
    "qa:cables": "node qa/cables.mjs",
    "qa:fusion": "node qa/cables-fusion.mjs",
    "qa:fixture-puerta": "node qa/fixture-puerta.mjs",
    "qa:multiproyecto": "vite build app --mode qa && node qa/todas.mjs multiproyecto",
    "qa:componentes": "vite build app --mode qa && node qa/todas.mjs componentes-personalizados",
    "qa:simulacion": "vite build app --mode qa && node qa/todas.mjs simulacion-industrial",
    "qa:agarre": "node qa/agarre.mjs",
    "qa:general": "node qa/general.mjs",
    "qa:tablero": "node qa/tablero-desde-cero.mjs",
    "qa:riel": "node qa/riel.mjs",
    "qa:nuevas": "node qa/riel-ejemplos-vista.mjs",
    "qa:mejoras": "node qa/mejoras.mjs",
    "qa:profesional": "node qa/profesional.mjs",
    "qa:entregables": "node qa/entregables.mjs",
    "qa:correcciones": "node qa/correcciones.mjs",
    "qa:estres-pro": "node qa/estres-profesional.mjs",
    "qa:estres": "node qa/estres.mjs",
    "qa:energizar": "node qa/energizar.mjs",
    "qa:planta": "node qa/planta.mjs",
    "qa:inicio": "node qa/inicio-vistas.mjs",
    "qa:prender": "node qa/prender-desde-cero.mjs",
    "qa:planta-trabajo": "node qa/planta-trabajo.mjs",
    "qa:esquema": "node qa/esquema-dossier.mjs",
    "qa:dossier": "node qa/dossier-editable.mjs",
    "qa:cubierta": "node qa/cubierta-obra.mjs",
    "extraer-planta": "python3 herramientas/extraer-planta.py",
    "qa:empaquetado": "npm run empaquetar && node qa/empaquetado.mjs",
    "qa:auditoria": "vite build app --mode qa && node qa/todas.mjs --gate",
    "check": "tsc --noEmit -p tsconfig.app.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.170.0",
    "playwright-core": "1.61.1",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  }
}
